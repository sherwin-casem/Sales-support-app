# =============================================================================
# Local development (no Docker for app code) — copy to .env in project root
#   cp .env.local.example .env
#
# Prerequisites:
#   1. Postgres running on localhost:5432 (Docker postgres only, or native install)
#   2. Apply schema: psql ... -f database/migrations/001_initial_schema.sql
#
# Terminal 1 — backend:
#   cd backend && python -m venv .venv
#   .venv\Scripts\activate          # Windows
#   pip install -r requirements.txt
#   uvicorn src.main:app --reload --port 8000
#
# Terminal 2 — frontend:
#   cd frontend && npm install && npm run dev
# =============================================================================

COMPOSE_PROJECT_NAME=sales-intelligence
ENVIRONMENT=development

# --- PostgreSQL (localhost — NOT the Docker service name) ---
POSTGRES_USER=salesapp
POSTGRES_PASSWORD=salesapp
POSTGRES_DB=salesapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://salesapp:salesapp@localhost:5432/salesapp
TEST_DATABASE_URL=postgresql+asyncpg://salesapp:salesapp@localhost:5432/salesapp_test
TEST_DATABASE_ADMIN_USER=postgres
TEST_DATABASE_ADMIN_PASSWORD=salesapp

# --- Redis (optional for current MVP; required for Celery later) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# REQUIRED: generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_generate_a_long_random_secret_key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional (Phase 4 — leave blank for now) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
PLAYWRIGHT_HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_PAGES=5

LOG_LEVEL=INFO
