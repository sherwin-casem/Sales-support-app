# =============================================================================
# Sales Intelligence & AI Outreach Platform — Environment Variables
# Copy to .env and adjust values for local development
# =============================================================================

# --- General ---
COMPOSE_PROJECT_NAME=sales-intelligence
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=salesapp
POSTGRES_PASSWORD=salesapp
POSTGRES_DB=salesapp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://salesapp:salesapp@postgres:5432/salesapp

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# --- JWT ---
JWT_ALGORITHM=HS256

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OpenAI (Phase 4) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email / SMTP (Phase 4 — campaign sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true

# --- Scraping (Phase 4) ---
PLAYWRIGHT_HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_PAGES=5

# --- Logging ---
LOG_LEVEL=INFO
